#!/usr/bin/env bash
# =============================================================================
# mixbay-oscmix-web — oscmix's Web UI as an Omarchy web app
# =============================================================================
# The browser frontend talks Web MIDI straight to the card, so it needs no
# engine and no AppImage. First run installs it as a normal Omarchy app entry
# (SUPER+SPACE) and seeds a dedicated Chromium profile with MIDI sysex
# already allowed, so the mixer opens without a permission prompt.
# =============================================================================
set -euo pipefail

URL="https://huddx01.github.io/oscmix/"
NAME="oscmix"
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/mosquitomixbay/oscmix-webapp"

warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }

# First run: the Omarchy entry, with this script as its Exec so every later
# launch reuses the profile below instead of the everyday browser profile.
if [[ ! -f $APPS/$NAME.desktop ]] && command -v omarchy-webapp-install >/dev/null 2>&1; then
  omarchy-webapp-install "$NAME" "$URL" "" "mixbay-oscmix-web" >/dev/null \
    || warn "could not add the oscmix web app to the app launcher"
fi

# Web MIDI sysex: the prompt would otherwise appear on the first strip move.
# A content-settings exception for this origin is what "Allow" writes.
if [[ ! -f $PROFILE/Default/Preferences ]]; then
  mkdir -p "$PROFILE/Default"
  cat > "$PROFILE/Default/Preferences" <<'JSON'
{"profile":{"content_settings":{"exceptions":{"midi_sysex":{"https://huddx01.github.io:443,*":{"last_modified":"13360000000000000","setting":1}}}}}}
JSON
fi

# Web apps need a Chromium-based browser; Omarchy's own launcher picks the
# same family, but the dedicated profile has to be passed here.
browser=""
for b in chromium chromium-browser google-chrome-stable brave brave-browser microsoft-edge; do
  if command -v "$b" >/dev/null 2>&1; then browser="$b"; break; fi
done
[[ -n $browser ]] \
  || { warn "no Chromium-based browser found — install chromium (omarchy install browser chromium)"; exit 1; }

exec "$browser" --app="$URL" --user-data-dir="$PROFILE" --no-first-run --no-default-browser-check "$@"
